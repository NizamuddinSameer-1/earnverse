# EarnVerse Environment Configuration Template (.env.example)
# Duplicate this file to .env and insert your real provider credentials.

# Database
DATABASE_URL="file:./dev.db"

# BitLabs Offerwall & Survey Integration
BITLABS_APP_TOKEN="your_bitlabs_app_token_here"
BITLABS_SECRET_KEY="your_bitlabs_secret_key_here"
BITLABS_S2S_KEY="your_bitlabs_s2s_key_here"

# CPX Research Survey Wall Integration
CPX_APP_ID="your_cpx_app_id_here"
CPX_SECURE_HASH="your_cpx_secure_hash_here"
CPX_SECRET_KEY="your_cpx_secure_hash_here"

# Next.js App URL (used for generating absolute callback URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
